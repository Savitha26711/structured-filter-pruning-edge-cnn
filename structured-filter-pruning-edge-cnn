        "# Step 10: Evaluate the pruned model\n",
        "\n",
        "import os\n",
        "import time\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torchvision\n",
        "import torchvision.transforms as transforms\n",
        "from torch.utils.data import DataLoader\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# Recreate the pruned architecture\n",
        "class PrunedCNN(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.features = nn.Sequential(\n",
        "            nn.Conv2d(3, 24, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.Conv2d(24, 24, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.MaxPool2d(2),\n",
        "            nn.Conv2d(24, 48, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.Conv2d(48, 48, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.MaxPool2d(2),\n",
        "            nn.Conv2d(48, 96, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.AdaptiveAvgPool2d((1, 1))\n",
        "        )\n",
        "        self.classifier = nn.Linear(96, 10)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.features(x)\n",
        "        return self.classifier(torch.flatten(x, 1))\n",
        "\n",
        "pruned_model = PrunedCNN().to(device)\n",
        "pruned_model.load_state_dict(\n",
        "    torch.load(\"pruned_cnn.pth\", map_location=device)\n",
        ")\n",
        "pruned_model.eval()\n",
        "\n",
        "test_dataset = torchvision.datasets.CIFAR10(\n",
        "    root=\"./data\",\n",
        "    train=False,\n",
        "    download=False,\n",
        "    transform=transforms.ToTensor()\n",
        ")\n",
        "\n",
        "test_loader = DataLoader(\n",
        "    test_dataset,\n",
        "    batch_size=256,\n",
        "    shuffle=False,\n",
        "    num_workers=2,\n",
        "    pin_memory=(device.type == \"cuda\")\n",
        ")\n",
        "\n",
        "# Measure test accuracy\n",
        "correct = 0\n",
        "total = 0\n",
        "\n",
        "with torch.no_grad():\n",
        "    for images, labels in test_loader:\n",
        "        images = images.to(device, non_blocking=True)\n",
        "        labels = labels.to(device, non_blocking=True)\n",
        "        predictions = pruned_model(images).argmax(dim=1)\n",
        "        correct += (predictions == labels).sum().item()\n",
        "        total += labels.size(0)\n",
        "\n",
        "test_accuracy = 100 * correct / total\n",
        "\n",
        "# Actual saved model size\n",
        "model_size_mb = os.path.getsize(\"pruned_cnn.pth\") / (1024 * 1024)\n",
        "\n",
        "# Warm-up\n",
        "sample = torch.randn(1, 3, 32, 32, device=device)\n",
        "\n",
        "with torch.no_grad():\n",
        "    for _ in range(20):\n",
        "        pruned_model(sample)\n",
        "\n",
        "if device.type == \"cuda\":\n",
        "    torch.cuda.synchronize()\n",
        "\n",
        "# Benchmark 1000 individual inferences\n",
        "latencies = []\n",
        "\n",
        "with torch.no_grad():\n",
        "    for _ in range(1000):\n",
        "        if device.type == \"cuda\":\n",
        "            torch.cuda.synchronize()\n",
        "\n",
        "        start = time.perf_counter()\n",

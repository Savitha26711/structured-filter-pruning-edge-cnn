        "\n",
        "# Step 7: Build a structurally pruned CNN\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "class PrunedCNN(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.features = nn.Sequential(\n",
        "            nn.Conv2d(3, 24, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.Conv2d(24, 24, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.MaxPool2d(2),\n",
        "\n",
        "            nn.Conv2d(24, 48, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.Conv2d(48, 48, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.MaxPool2d(2),\n",
        "\n",
        "            nn.Conv2d(48, 96, 3, padding=1),\n",
        "            nn.ReLU(),\n",
        "            nn.AdaptiveAvgPool2d((1, 1))\n",
        "        )\n",
        "        self.classifier = nn.Linear(96, 10)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.features(x)\n",
        "        return self.classifier(torch.flatten(x, 1))\n",
        "\n",
        "\n",
        "# Load the trained baseline weights\n",
        "baseline = BaselineCNN().to(device)\n",
        "baseline.load_state_dict(\n",
        "    torch.load(\"baseline_cnn.pth\", map_location=device)\n",
        ")\n",
        "baseline.eval()\n",
        "\n",
        "pruned_model = PrunedCNN().to(device)\n",
        "\n",
        "# Copy selected filters and corresponding input-channel weights\n",
        "with torch.no_grad():\n",
        "    old_convs = [\n",
        "        baseline.features[0],\n",
        "        baseline.features[2],\n",
        "        baseline.features[5],\n",
        "        baseline.features[7],\n",
        "        baseline.features[10]\n",
        "    ]\n",
        "    new_convs = [\n",
        "        pruned_model.features[0],\n",
        "        pruned_model.features[2],\n",
        "        pruned_model.features[5],\n",
        "        pruned_model.features[7],\n",
        "        pruned_model.features[10]\n",
        "    ]\n",
        "\n",
        "    previous_indices = torch.arange(3, device=device)\n",
        "\n",
        "    for old_layer, new_layer in zip(old_convs, new_convs):\n",
        "        output_indices = torch.arange(\n",
        "            new_layer.out_channels, device=device\n",
        "        )\n",
        "        new_layer.weight.copy_(\n",
        "            old_layer.weight[output_indices][:, previous_indices]\n",
        "        )\n",
        "        new_layer.bias.copy_(old_layer.bias[output_indices])\n",
        "        previous_indices = output_indices\n",
        "\n",
        "    # Copy the matching classifier weights\n",
        "    pruned_model.classifier.weight.copy_(\n",
        "        baseline.classifier.weight[:, previous_indices]\n",
        "    )\n",
        "    pruned_model.classifier.bias.copy_(\n",
        "        baseline.classifier.bias\n",
        "    )\n",
        "\n",
        "print(\"Baseline parameters:\",\n",
        "      sum(p.numel() for p in baseline.parameters()))\n",
        "print(\"Pruned parameters:\",\n",
        "      sum(p.numel() for p in pruned_model.parameters()))\n",
        "print(\"Pruned CNN created successfully!\")\n"
